# ─────────────────────────────────────────────────────────────────────────────
# TrustGate AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=TrustGate AI
APP_ENV=development                      # development | staging | production
DEBUG=true                               # Set to false in production
SECRET_KEY=change-this-to-a-32-char-secret-in-production
JWT_SECRET=change-this-to-a-32-char-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────
# Demo Mode (set to false for production)
# ─────────────────────────────────────────────
DEMO_MODE=true                           # true = no Azure services required

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100                  # requests per window
RATE_LIMIT_WINDOW_SECONDS=60             # window in seconds
VERIFICATION_RATE_LIMIT=10              # max verification starts per hour per IP

# ─────────────────────────────────────────────
# Azure OpenAI
# ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # Your GPT-4o deployment name
AZURE_OPENAI_API_VERSION=2024-02-01

# ─────────────────────────────────────────────
# Azure Cosmos DB
# ─────────────────────────────────────────────
COSMOS_DB_URL=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-db-primary-key
COSMOS_DB_DATABASE=trustgate
COSMOS_CONTAINER_VERIFICATIONS=verifications
COSMOS_CONTAINER_SESSIONS=sessions
COSMOS_CONTAINER_AUDIT_LOGS=audit_logs
COSMOS_CONTAINER_USERS=users
COSMOS_CONTAINER_PASSPORTS=passports

# ─────────────────────────────────────────────
# Azure Blob Storage
# ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=trustgate-reports

# ─────────────────────────────────────────────
# Azure Key Vault
# ─────────────────────────────────────────────
AZURE_KEY_VAULT_URL=https://YOUR_KEYVAULT.vault.azure.net/

# ─────────────────────────────────────────────
# Microsoft Entra ID (Azure AD)
# ─────────────────────────────────────────────
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# ─────────────────────────────────────────────
# Frontend Environment Variables (Vite)
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_DEMO_MODE=true
VITE_APP_VERSION=1.0.0
VITE_AZURE_CLIENT_ID=your-app-client-id
VITE_AZURE_TENANT_ID=your-tenant-id

# ─────────────────────────────────────────────
# Trust Score Thresholds
# ─────────────────────────────────────────────
TRUST_THRESHOLD_LOW=80                   # Score >= 80 = LOW risk
TRUST_THRESHOLD_MEDIUM=60               # Score >= 60 = MEDIUM risk
TRUST_THRESHOLD_HIGH=40                 # Score >= 40 = HIGH risk
                                        # Score < 40  = CRITICAL risk

# ─────────────────────────────────────────────
# Face Engine Settings
# ─────────────────────────────────────────────
FACE_EAR_THRESHOLD=0.25                 # Eye Aspect Ratio blink threshold
FACE_MIN_DETECTION_CONFIDENCE=0.7
FACE_MIN_TRACKING_CONFIDENCE=0.5
FACE_LIVENESS_MIN_FRAMES=30             # Minimum frames for liveness analysis
FACE_SPOOF_THRESHOLD=0.6               # Above this = spoof detected

# ─────────────────────────────────────────────
# Voice Engine Settings
# ─────────────────────────────────────────────
VOICE_WHISPER_MODEL=base               # tiny | base | small | medium | large
VOICE_SPEAKER_SIMILARITY_THRESHOLD=0.75
VOICE_MIN_SNR_DB=10                    # Minimum signal-to-noise ratio
VOICE_CLONE_THRESHOLD=0.65             # Above this = clone detected
VOICE_REPLAY_THRESHOLD=0.70            # Above this = replay detected

# ─────────────────────────────────────────────
# Trust Passport
# ─────────────────────────────────────────────
PASSPORT_TTL_LOW_RISK_MINUTES=60       # 1 hour for low risk
PASSPORT_TTL_MEDIUM_RISK_MINUTES=30    # 30 minutes for medium risk
PASSPORT_SIGNING_KEY_ID=trustgate-signing-key-v1
PASSPORT_ISSUER=https://trustgate.ai
